# Canales del formulario de contacto de la landing. Son públicos (quedan en la página).
# Cópielo a .env.local (ignorado por git) y complete los valores antes de construir.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_BOOKING_URL=
# Conteo de visitas de la landing (Cloudflare Web Analytics, sin cookies). Opcional: sin token no se mide nada.
# Token del sitio: Cloudflare > Analytics & Logs > Web Analytics > Manage site > «token» del snippet.
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=
